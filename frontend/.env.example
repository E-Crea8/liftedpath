# Local WordPress REST root. Production on Vercel must be https://cms.liftedpathfoundation.org/wp-json
# Never point Production at www/apex liftedpathfoundation.org or at liftedpath.local.
WORDPRESS_API_URL=http://liftedpath.local/wp-json

# Draft preview. Set locally in .env.local. Do not commit the values.
WORDPRESS_PREVIEW_USER=
WORDPRESS_PREVIEW_APP_PASSWORD=

# Shared with WordPress option liftedpath_revalidate_secret. Set locally. Do not commit the value.
REVALIDATE_SECRET=
# Shared with WordPress option liftedpath_preview_secret. Set locally. Do not commit the value.
PREVIEW_SECRET=
