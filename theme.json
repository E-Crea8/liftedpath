{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"name": "Paper",
					"slug": "paper",
					"color": "#FCFDFD"
				},
				{
					"name": "Teal",
					"slug": "teal",
					"color": "#043C42"
				},
				{
					"name": "Deep",
					"slug": "deep",
					"color": "#02272B"
				},
				{
					"name": "Gold",
					"slug": "gold",
					"color": "#B78D4B"
				},
				{
					"name": "Bronze",
					"slug": "bronze",
					"color": "#A57D3C"
				},
				{
					"name": "Sand",
					"slug": "sand",
					"color": "#D6B886"
				},
				{
					"name": "Surface",
					"slug": "surface",
					"color": "#E7ECEC"
				},
				{
					"name": "Warm",
					"slug": "warm",
					"color": "#F3ECE0"
				},
				{
					"name": "Cool",
					"slug": "cool",
					"color": "#D3DBDD"
				},
				{
					"name": "Muted",
					"slug": "muted",
					"color": "#4C6E71"
				},
				{
					"name": "Line",
					"slug": "line",
					"color": "#D3DCDC"
				}
			]
		},
		"typography": {
			"fluid": false,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"name": "Plus Jakarta Sans",
					"slug": "body",
					"fontFamily": "\"Plus Jakarta Sans\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Plus Jakarta Sans",
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD",
							"src": [
								"file:./assets/fonts/plus-jakarta-sans-latin.woff2"
							]
						},
						{
							"fontFamily": "Plus Jakarta Sans",
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF",
							"src": [
								"file:./assets/fonts/plus-jakarta-sans-latin-ext.woff2"
							]
						}
					]
				},
				{
					"name": "Stack Sans Headline",
					"slug": "display",
					"fontFamily": "\"Stack Sans Headline\", \"Plus Jakarta Sans\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Stack Sans Headline",
							"fontWeight": "200 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD",
							"src": [
								"file:./assets/fonts/stack-sans-headline-latin.woff2"
							]
						},
						{
							"fontFamily": "Stack Sans Headline",
							"fontWeight": "200 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF",
							"src": [
								"file:./assets/fonts/stack-sans-headline-latin-ext.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"name": "Display",
					"slug": "display",
					"size": "clamp(3rem, 6.25vw, 5rem)",
					"fluid": false
				},
				{
					"name": "Heading",
					"slug": "heading",
					"size": "clamp(2.25rem, 4.38vw, 3.5rem)",
					"fluid": false
				},
				{
					"name": "Heading 3",
					"slug": "heading-3",
					"size": "1.28rem",
					"fluid": false
				},
				{
					"name": "Stat",
					"slug": "stat",
					"size": "2.6rem",
					"fluid": false
				},
				{
					"name": "Body large",
					"slug": "body-large",
					"size": "1.03rem",
					"fluid": false
				},
				{
					"name": "Body",
					"slug": "body",
					"size": "1rem",
					"fluid": false
				},
				{
					"name": "Eyebrow",
					"slug": "eyebrow",
					"size": "0.85rem",
					"fluid": false
				},
				{
					"name": "Navigation",
					"slug": "nav",
					"size": "0.86rem",
					"fluid": false
				},
				{
					"name": "Button",
					"slug": "button",
					"size": "0.83rem",
					"fluid": false
				},
				{
					"name": "Caption",
					"slug": "caption",
					"size": "0.78rem",
					"fluid": false
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "name": "4", "slug": "4", "size": "4px" },
				{ "name": "8", "slug": "8", "size": "8px" },
				{ "name": "12", "slug": "12", "size": "12px" },
				{ "name": "16", "slug": "16", "size": "16px" },
				{ "name": "18", "slug": "18", "size": "18px" },
				{ "name": "20", "slug": "20", "size": "20px" },
				{ "name": "24", "slug": "24", "size": "24px" },
				{ "name": "28", "slug": "28", "size": "28px" },
				{ "name": "32", "slug": "32", "size": "32px" },
				{ "name": "40", "slug": "40", "size": "40px" },
				{ "name": "48", "slug": "48", "size": "48px" },
				{ "name": "64", "slug": "64", "size": "64px" },
				{ "name": "65", "slug": "65", "size": "65px" },
				{ "name": "80", "slug": "80", "size": "80px" },
				{ "name": "96", "slug": "96", "size": "96px" },
				{ "name": "128", "slug": "128", "size": "128px" }
			]
		},
		"layout": {
			"contentSize": "1120px",
			"wideSize": "1120px"
		},
		"custom": {
			"headerHeight": "89px",
			"lineHeight": {
				"heading": "1.15",
				"body": "1.58"
			},
			"radius": {
				"small": "8px",
				"control": "14px",
				"image": "16px",
				"card": "18px",
				"pill": "999px"
			},
			"shadow": {
				"card": "0 14px 34px rgba(2, 39, 43, 0.10)",
				"note": "0 15px 30px rgba(2, 39, 43, 0.12)"
			},
			"color": {
				"error": "#8C3A32",
				"success": "#1B5E3B",
				"veil": "linear-gradient(90deg, color-mix(in oklch, #02272B 96%, transparent), color-mix(in oklch, #02272B 68%, transparent) 52%, color-mix(in oklch, #02272B 35%, transparent))"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--teal)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"fontWeight": "400",
			"lineHeight": "1.58"
		},
		"spacing": {
			"blockGap": "24px",
			"padding": {
				"top": "0px",
				"right": "24px",
				"bottom": "0px",
				"left": "24px"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.15",
					"letterSpacing": "0"
				},
				"color": {
					"text": "var(--wp--preset--color--teal)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)",
					"fontWeight": "600",
					"lineHeight": "1.15"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading)",
					"fontWeight": "500",
					"lineHeight": "1.15"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-3)",
					"fontWeight": "600",
					"lineHeight": "1.28"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--teal)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--bronze)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--gold)",
					"text": "var(--wp--preset--color--teal)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--teal)",
						"text": "var(--wp--preset--color--paper)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--button)",
					"fontWeight": "800",
					"letterSpacing": "0"
				},
				"border": {
					"radius": "999px",
					"width": "0",
					"style": "none"
				},
				"spacing": {
					"padding": {
						"top": "14px",
						"right": "20px",
						"bottom": "14px",
						"left": "20px"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--caption)"
				}
			}
		},
		"css": "@media (max-width: 760px) { body { --wp--style--root--padding-right: 18px; --wp--style--root--padding-left: 18px; } } @media (max-width: 520px) { body h1 { font-size: clamp(2.45rem, 11vw, 3.3rem); } body h2 { font-size: 2.15rem; } } :where(a, button, input, select, textarea, .wp-element-button):focus-visible { outline: 2px solid var(--wp--preset--color--bronze); outline-offset: 3px; } .wp-element-button, .wp-block-button__link { min-height: 48px; }"
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	]
}
