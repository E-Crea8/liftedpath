{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "liftedpath/pathway-cards",
	"title": "Pathway cards",
	"category": "liftedpath",
	"icon": "welcome-learn-more",
	"description": "Two-column learning pathway grid with numbered cards.",
	"keywords": ["pathway", "learning", "cards"],
	"textdomain": "liftedpath",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"supports": {
		"anchor": true,
		"align": ["full"],
		"html": false,
		"jsx": false,
		"mode": false,
		"spacing": false,
		"color": false,
		"typography": false
	},
	"acf": {
		"blockVersion": 3,
		"mode": "preview",
		"renderTemplate": "render.php"
	}
}
