{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "liftedpath/sponsor-callout",
	"title": "Sponsor callout",
	"category": "liftedpath",
	"icon": "heart",
	"description": "A short sponsorship amount and link.",
	"keywords": ["sponsor", "amount"],
	"textdomain": "liftedpath",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"supports": {
		"anchor": true,
		"align": ["full"],
		"html": false,
		"jsx": false,
		"mode": false,
		"spacing": false,
		"color": false,
		"typography": false
	},
	"acf": {
		"blockVersion": 3,
		"mode": "preview",
		"renderTemplate": "render.php"
	}
}
