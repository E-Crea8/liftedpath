{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "liftedpath/program-cards",
	"title": "Program cards",
	"category": "liftedpath",
	"icon": "grid-view",
	"description": "Overlay photograph cards for initiatives, with an optional sponsor cell.",
	"keywords": ["programs", "initiatives", "cards", "overlay"],
	"textdomain": "liftedpath",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"supports": {
		"anchor": true,
		"align": ["full"],
		"html": false,
		"jsx": false,
		"mode": false,
		"spacing": false,
		"color": false,
		"typography": false
	},
	"acf": {
		"blockVersion": 3,
		"mode": "preview",
		"renderTemplate": "render.php"
	}
}
