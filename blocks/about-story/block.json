{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "liftedpath/about-story",
	"title": "About story",
	"category": "liftedpath",
	"icon": "text",
	"description": "Eyebrow, heading, paragraphs, and photograph for the About page.",
	"keywords": ["about", "story"],
	"textdomain": "liftedpath",
	"attributes": {
		"align": { "type": "string", "default": "full" }
	},
	"supports": {
		"anchor": true,
		"align": ["full"],
		"html": false,
		"jsx": false,
		"mode": false,
		"spacing": false,
		"color": false,
		"typography": false
	},
	"acf": {
		"blockVersion": 3,
		"mode": "preview",
		"renderTemplate": "render.php"
	}
}
