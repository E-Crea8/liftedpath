{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "liftedpath/gallery",
	"title": "Gallery",
	"category": "liftedpath",
	"icon": "format-gallery",
	"description": "Photographs and videos in a responsive mosaic or grid.",
	"keywords": ["gallery", "photos", "videos", "impact"],
	"textdomain": "liftedpath",
	"attributes": {
		"align": { "type": "string", "default": "full" }
	},
	"supports": {
		"anchor": true,
		"align": ["full"],
		"html": false,
		"jsx": false,
		"mode": false,
		"spacing": false,
		"color": false,
		"typography": false
	},
	"acf": {
		"blockVersion": 3,
		"mode": "preview",
		"renderTemplate": "render.php"
	}
}
