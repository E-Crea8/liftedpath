{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "liftedpath/page-hero",
	"title": "Page hero",
	"category": "liftedpath",
	"icon": "align-wide",
	"description": "Inner page hero with a photograph and breadcrumb.",
	"keywords": ["hero", "page"],
	"textdomain": "liftedpath",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"supports": {
		"anchor": true,
		"align": ["full"],
		"html": false,
		"jsx": false,
		"mode": false,
		"spacing": false,
		"color": false,
		"typography": false
	},
	"acf": {
		"blockVersion": 3,
		"mode": "preview",
		"renderTemplate": "render.php"
	}
}
