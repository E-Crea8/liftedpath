{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "liftedpath/contact-form",
	"title": "Contact form",
	"category": "liftedpath",
	"icon": "email",
	"description": "Contact details and a message form. Sending is connected later.",
	"keywords": ["contact", "form"],
	"textdomain": "liftedpath",
	"attributes": {
		"align": { "type": "string", "default": "full" }
	},
	"supports": {
		"anchor": true,
		"align": ["full"],
		"html": false,
		"jsx": false,
		"mode": false,
		"spacing": false,
		"color": false,
		"typography": false
	},
	"acf": {
		"blockVersion": 3,
		"mode": "preview",
		"renderTemplate": "render.php"
	}
}
