{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "liftedpath/donate-panel",
	"title": "Donate panel",
	"category": "liftedpath",
	"icon": "heart",
	"description": "Gift choices. No payment is collected.",
	"keywords": ["donate", "gift"],
	"textdomain": "liftedpath",
	"attributes": {
		"align": { "type": "string", "default": "full" }
	},
	"supports": {
		"anchor": true,
		"align": ["full"],
		"html": false,
		"jsx": false,
		"mode": false,
		"spacing": false,
		"color": false,
		"typography": false
	},
	"acf": {
		"blockVersion": 3,
		"mode": "preview",
		"renderTemplate": "render.php"
	}
}
