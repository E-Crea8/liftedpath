{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "liftedpath/marquee",
	"title": "Marquee",
	"category": "liftedpath",
	"icon": "slides",
	"description": "A looping line of phrases.",
	"keywords": ["marquee", "ticker"],
	"textdomain": "liftedpath",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"supports": {
		"anchor": true,
		"align": ["full"],
		"html": false,
		"jsx": false,
		"mode": false,
		"spacing": false,
		"color": false,
		"typography": false
	},
	"acf": {
		"blockVersion": 3,
		"mode": "preview",
		"renderTemplate": "render.php"
	}
}
